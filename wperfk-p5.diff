diff --git a/scripts/login-token.lua b/scripts/login-token.lua
new file mode 100644
index 0000000..a15f7e3
--- /dev/null
+++ b/scripts/login-token.lua
@@ -0,0 +1,22 @@
+-- Request sequence with state: log in, then reuse the token for every request
+-- on that thread. (Connections that send before the first login response
+-- arrives log in too.)
+-- Expects the login response body to contain "token":"<value>".
+--
+--   wperfk -t2 -c10 -d30s -s scripts/login-token.lua https://api.example.com
+
+local token = nil
+
+request = function()
+   if not token then
+      return wrk.format("POST", "/login", { ["Content-Type"] = "application/json" },
+                        '{"user":"demo","password":"demo"}')
+   end
+   return wrk.format("GET", "/profile", { ["Authorization"] = "Bearer " .. token })
+end
+
+response = function(status, headers, body)
+   if not token and status == 200 then
+      token = body:match('"token"%s*:%s*"([^"]+)"')
+   end
+end
diff --git a/scripts/unique-id.lua b/scripts/unique-id.lua
new file mode 100644
index 0000000..11de40c
--- /dev/null
+++ b/scripts/unique-id.lua
@@ -0,0 +1,17 @@
+-- A unique id in every request body, for endpoints that reject duplicates.
+--
+--   wperfk -t4 -c50 -d30s -s scripts/unique-id.lua https://api.example.com/orders
+
+local counter = 0
+local prefix
+
+init = function(args)
+   -- distinct per thread (thread address) and per run (start time in us)
+   prefix = string.format("%.0f-%s", wrk.time_us(), tostring(wrk.thread):match("0x%x+") or "t")
+end
+
+request = function()
+   counter = counter + 1
+   local body = string.format('{"id":"%s-%d","qty":1}', prefix, counter)
+   return wrk.format("POST", nil, { ["Content-Type"] = "application/json" }, body)
+end
