diff --git a/tools/build-openssl.sh b/tools/build-openssl.sh
new file mode 100755
index 0000000..b0690b9
--- /dev/null
+++ b/tools/build-openssl.sh
@@ -0,0 +1,44 @@
+#!/usr/bin/env bash
+# Build a static OpenSSL (pinned version, verified tarball) for release builds.
+#
+# Usage: tools/build-openssl.sh <prefix> [Configure args...]
+#   e.g. MACOSX_DEPLOYMENT_TARGET=11.0 tools/build-openssl.sh "$HOME/openssl" -mmacosx-version-min=11.0
+#
+# Skips the build if <prefix>/lib/libssl.a already exists (CI cache hit).
+set -euo pipefail
+
+OPENSSL_VERSION=${OPENSSL_VERSION:-3.5.8}
+OPENSSL_SHA256=${OPENSSL_SHA256:-a8f84a39918ec6415ce765d9b429d313ba97b8143169c172e734b9514464f5b2}
+
+prefix=${1:?usage: $0 <prefix> [Configure args...]}
+shift
+
+if [ -f "$prefix/lib/libssl.a" ] && [ -f "$prefix/lib/libcrypto.a" ]; then
+  echo "OpenSSL already built in $prefix"
+  exit 0
+fi
+
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+tarball="$work/openssl-$OPENSSL_VERSION.tar.gz"
+
+curl -fsSL -o "$tarball" \
+  "https://github.com/openssl/openssl/releases/download/openssl-$OPENSSL_VERSION/openssl-$OPENSSL_VERSION.tar.gz"
+
+if command -v sha256sum >/dev/null; then
+  actual=$(sha256sum "$tarball" | cut -d' ' -f1)
+else
+  actual=$(shasum -a 256 "$tarball" | cut -d' ' -f1)
+fi
+if [ "$actual" != "$OPENSSL_SHA256" ]; then
+  echo "OpenSSL $OPENSSL_VERSION checksum mismatch: $actual" >&2
+  exit 1
+fi
+
+tar -xzf "$tarball" -C "$work"
+cd "$work/openssl-$OPENSSL_VERSION"
+./Configure no-shared no-tests no-docs no-module no-engine \
+  --prefix="$prefix" --libdir=lib "$@"
+make -j"$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)" build_libs
+make install_dev
+echo "OpenSSL $OPENSSL_VERSION installed in $prefix"
diff --git a/tools/package.sh b/tools/package.sh
index 8dd29d9..67d0dee 100755
--- a/tools/package.sh
+++ b/tools/package.sh
@@ -2,6 +2,8 @@
 # Usage: tools/package.sh <version> <os> <arch> [binary]
 # Produces dist/wperfk_<version>_<os>_<arch>.tar.gz (.zip for windows)
 # with the binary, LICENSE, NOTICE and README.md at the archive root.
+# The packaged binary is stripped (STRIP overrides the tool, e.g. for cross
+# builds; STRIP=: disables it) and, when it can run here, smoke-run with -v.
 set -euo pipefail
 ver=$1 os=$2 arch=$3
 bin=${4:-wperfk}; [ "$os" = windows ] && bin=${4:-wperfk.exe}
@@ -10,6 +12,20 @@ stage=$(mktemp -d)
 trap 'rm -rf "$stage"' EXIT
 mkdir -p dist
 cp "$bin" LICENSE NOTICE README.md "$stage/"
+exe="$stage/$(basename "$bin")"
+
+strip_tool=${STRIP:-$(command -v strip || command -v llvm-strip || true)}
+if [ -n "$strip_tool" ]; then
+  "$strip_tool" "$exe"
+else
+  echo "warning: no strip tool found; packaging an unstripped binary" >&2
+fi
+if [ "$(uname -s)" = Darwin ]; then
+  codesign --force --sign - "$exe"   # arm64 needs a valid (ad-hoc) signature after strip
+fi
+if [ -z "${CROSS_PACKAGE:-}" ]; then
+  "$exe" -v >/dev/null   # the stripped binary must still start
+fi
 if [ "$os" = windows ]; then
   out="$PWD/dist/$name.zip"
   if command -v zip >/dev/null; then (cd "$stage" && zip -q -9 "$out" ./*)
